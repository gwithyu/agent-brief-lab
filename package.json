    "evaluate": "node evaluation/run.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "js-tiktoken": "1.0.21"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwithyu/agent-brief-lab.git"
  },
  "bugs": {
    "url": "https://github.com/gwithyu/agent-brief-lab/issues"
  },
  "homepage": "https://github.com/gwithyu/agent-brief-lab#readme",
  "files": [
    "*.cjs",
    "examples/",
    "test/",
    "README.md",
    "RESULTS.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE_NOTES.md",
    "VERIFICATION.md",
    "demo-results.json",
    "real-source-results.json",
    "EVALUATION.md",
    "evaluation/",
    "ACTIVE_AGENT.md"
  ]
